# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Generated reports
reports/*.md
!reports/.gitkeep

# Local config overrides
config/local.yaml

# Testing
.pytest_cache/
.coverage
htmlcov/
.venv/
.claude/

# CONSCIOUSNESS tracking file symlinks (point to subdirectories)
CONSCIOUSNESS/ROADMAP.md
CONSCIOUSNESS/EPICS.md
CONSCIOUSNESS/STORY.md
CONSCIOUSNESS/TASKS.md
CONSCIOUSNESS/BACKLOG.md

# CONSCIOUSNESS runtime files (STM locks and versions)
*.lock
CONSCIOUSNESS/*.lock

# CONSCIOUSNESS legacy symlinks (if they exist - point to subdirectories)
CONSCIOUSNESS/ROADMAP.md
CONSCIOUSNESS/EPICS.md
CONSCIOUSNESS/STORY.md
CONSCIOUSNESS/TASKS.md
CONSCIOUSNESS/BACKLOG.md

# Runtime session data (generated by hooks during sessions)
.claude/.session-metadata.json
.claude/.session-state.json
.claude/.todo-sync-time
.todo-sync-time
*.session.json

# .claude/settings.json should be committed (project-specific configuration)
# .claude/commands/ should be committed (slash commands)

# Deployed copies (propagated from hooks/, skills/, .claude/agents/ source dirs)
.claude/hooks/
.claude/skills/
.claude/memory/

# CONSCIOUSNESS brain files that shouldn't be in git (runtime only)
CONSCIOUSNESS/performance/sessions/*.json
CONSCIOUSNESS/scratchpad/current-context.md
CONSCIOUSNESS/*.lock

# Logs directory (session output)
logs/

# Local machine data — worklogs and incident logs are machine-specific, never public
data/

# Saved session transcripts (from /consciousness:issue) — full conversation history,
# never public
chats/

# Environment secrets
.env
.env.*
!.env.example

# Rust
target/
# Cargo.lock is committed — koi is a binary application, so a locked,
# reproducible dependency set is wanted for CI builds and releases.
# (Overrides the broad *.lock rule above.)
!Cargo.lock

# ── Private/operational layer — never in the public repo, on any machine ──
# These were previously untracked only via .git/info/exclude, which does not
# travel with the repo: a fresh clone (the other machine, or anyone else) had
# nothing stopping them from being added and pushed. Tracked here so the
# exclusion holds everywhere. CLAUDE.md and AGENTS.md are tracked on purpose:
# they carry rules only — machine-specific state lives in data/host.yaml.
/CONSCIOUSNESS/
/src/
/pyproject.toml
/.python-version
/deploy/
/dotfiles/
/hooks/
/skills/
/evals/
/reports/
/gdrive-migration-playbook.md
/LINUX_STORAGE_REQUEST.md
/docs/DEPLOYMENT.md
/docs/PROJECT-STATUS.md
/docs/BUSINESS-PLAN.md
/config/*.dconf
/config/*.service
.aider*
